		"iconv-lite": "^0.7.1",
		"less": "^4.4.2",
		"sass-embedded": "^1.96.0",
		"typescript": "^4.9.4",
		"unplugin-auto-import": "^20.3.0",
		"unplugin-vue-components": "^30.0.0",
		"vite": "^7.2.7",
		"vue-tsc": "^1.0.24"
	}
}
